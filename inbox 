            </div>
            <div class="space-y-2">
              <input type="password" id="gemini-key-input" value="${apiKeyStored}" placeholder="AIzaSy..." class="w-full bg-lumina-900 border border-lumina-700/60 rounded-xl px-3.5 py-2.5 text-sm font-mono text-slate-200 focus:outline-none focus:border-lumina-purple" />
              <p class="text-[11px] text-slate-500">Your key remains client-side in your private browser storage. It is never exposed or falsified.</p>
            </div>
            <button onclick="saveApiKey()" class="px-4 py-2 rounded-xl bg-lumina-800 hover:bg-lumina-700 text-white text-xs font-semibold transition-colors">
              Save API Configuration
            </button>
          </div>
        </div>
      `;
    }

    function renderIntegrationPhasePlaceholder(featureName) {
      const titles = {
        student: 'Student Learning Assistant (Phase 5)',
        coding: 'Coding Assistant & Execution Guide (Phase 7)',
        business: 'Business Advisor & Market Research (Phase 7)',
        trading: 'Trading Chart Vision Analysis (Phase 10)',
        'image-gen': 'AI Image Generation Studio (Phase 9)',
        'video-gen': 'AI Video Generation Studio (Phase 9)',
        'audio-studio': 'AI Audio Studio & Voice Narration (Phase 9)',
        documents: 'PDF & Document Analysis (Phase 5)',
        history: 'Encrypted History & Cloud Memory (Phase 3)'
      };

      const title = titles[featureName] || featureName.toUpperCase();

      return `
        <div class="max-w-3xl mx-auto px-4 py-16 text-center space-y-6">
          <div class="inline-flex p-4 rounded-3xl bg-lumina-purple/10 border border-lumina-purple/30 text-lumina-purple">
            <i data-lucide="shield-alert" class="w-10 h-10"></i>
          </div>
          <div class="space-y-2">
            <h2 class="text-2xl font-bold text-white">${title}</h2>
            <div class="inline-block px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-semibold">
              Integration Required
            </div>
            <p class="text-sm text-slate-400 max-w-md mx-auto pt-2">
              In accordance with Lumina AI verification rules, placeholder outputs or simulated results are strictly disallowed. Real-time API endpoints will activate sequentially in this feature's dedicated development phase.
            </p>
          </div>
          <button onclick="navigateTo('home')" class="px-5 py-2.5 rounded-xl bg-lumina-900 border border-lumina-700 hover:border-lumina-purple text-xs font-bold text-slate-200">
            Return to Dashboard
          </button>
        </div>
      `;
    }

    /* -------------------------------------------------------------
       INPUT & CHAT HANDLERS
       ------------------------------------------------------------- */
    function startNewChat() {
      navigateTo('assistant');
      showToast("Initialized new clean chat session", "plus-circle");
    }

    function fillPrompt(text) {
      const textarea = document.getElementById('chat-textarea');
      if (textarea) {
        textarea.value = text;
        textarea.focus();
      }
    }

    function sendMessage() {
      const textarea = document.getElementById('chat-textarea');
      if (!textarea) return;
      const query = textarea.value.trim();
      if (!query) return;

      const container = document.getElementById('chat-messages');

      // 1. Render User Message
      const userBubble = `
        <div class="flex items-start justify-end gap-3">
          <div class="rounded-2xl rounded-tr-sm bg-lumina-purple p-4 max-w-[85%] text-white text-sm shadow-md">
            <p class="text-xs font-semibold text-lumina-silver mb-1">You</p>
            <p class="leading-relaxed whitespace-pre-wrap">${escapeHTML(query)}</p>
          </div>
          <div class="w-8 h-8 rounded-full bg-lumina-800 border border-lumina-700 flex items-center justify-center text-slate-300 shrink-0 mt-0.5">
            <i data-lucide="user" class="w-4 h-4"></i>
          </div>
        </div>
      `;
      container.insertAdjacentHTML('beforeend', userBubble);
      textarea.value = '';

      // 2. Real Provider Check (Gemini Key Check for Phase 2 readiness)
      const apiKey = localStorage.getItem('lumina_gemini_key');

      if (!apiKey) {
        setTimeout(() => {
          const noticeBubble = `
            <div class="flex items-start gap-3">
              <div class="w-8 h-8 rounded-full bg-gradient-lumina flex items-center justify-center text-white shrink-0 mt-0.5">
                <i data-lucide="sparkles" class="w-4 h-4"></i>
              </div>
              <div class="rounded-2xl rounded-tl-sm glass-panel p-4 max-w-[85%] border border-amber-500/40">
                <p class="text-xs font-semibold text-amber-400 mb-1">Integration Required (Phase 2)</p>
                <p class="text-xs text-slate-300 leading-relaxed">
                  Lumina AI adheres strictly to the rule: <em>Do not use fake AI responses. If an API is not connected, show 'Integration required' instead of pretending the feature works.</em>
                </p>
                <p class="text-xs text-slate-400 mt-2">
                  Please open <button onclick="navigateTo('settings')" class="text-lumina-cyan underline font-semibold">Settings</button> to configure your real Google Gemini API Key.
                </p>
              </div>
            </div>
          `;
          container.insertAdjacentHTML('beforeend', noticeBubble);
          lucide.createIcons();
          container.scrollTop = container.scrollHeight;
        }, 300);
      } else {
        // Phase 2 will execute real call here
        showToast("Gemini Key detected. Live API streaming initiates in Phase 2.", "cpu");
      }

      lucide.createIcons();
      container.scrollTop = container.scrollHeight;
    }

    function saveApiKey() {
      const key = document.getElementById('gemini-key-input').value.trim();
      if (key) {
        localStorage.setItem('lumina_gemini_key', key);
        showToast("Gemini API Key saved securely client-side.", "check-check");
      } else {
        localStorage.removeItem('lumina_gemini_key');
        showToast("Gemini API key cleared.", "trash-2");
      }
    }

    function handleAttachmentTrigger(type) {
      showToast(`${type === 'image' ? 'Image Analysis' : 'PDF Document Analysis'} integration required (Phases 4 & 5).`, 'alert-circle');
    }

    function handleVoiceTrigger() {
      showToast("Voice assistant audio input engine ready for Phase 8 integration.", "mic");
    }

    function handleSubscribeTier(tierName) {
      state.subscriptionTier = tierName;
      if (state.user) {
        state.user.tier = tierName;
        localStorage.setItem('lumina_user', JSON.stringify(state.user));
      }
      showToast(`Selected ${tierName} Tier. Stripe payment integration required in Phase 11.`, "sparkles");
    }

    function escapeHTML(str) {
      return str.replace(/[&<>'"]/g, 
        tag => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[tag] || tag)
      );
    }

    // Initialize application on DOM ready
    window.addEventListener('DOMContentLoaded', initApp);
  </script>
</body>
</html>