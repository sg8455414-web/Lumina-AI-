  <!-- ================= APPLICATION SCRIPTS ================= -->
  <script>
    /* -------------------------------------------------------------
       STATE MANAGEMENT & ARCHITECTURE
       ------------------------------------------------------------- */
    const state = {
      user: null, // Holds authenticated profile
      currentView: 'home',
      theme: 'dark',
      activeProvider: 'Google Gemini (Ready for Key)',
      subscriptionTier: 'Free',
      chatSessions: [],
      currentChatId: null
    };

    // Initialize LocalStorage Persistence
    function initApp() {
      const savedUser = localStorage.getItem('lumina_user');
      if (savedUser) {
        try { state.user = JSON.parse(savedUser); } catch(e) {}
      }
      const savedTheme = localStorage.getItem('lumina_theme') || 'dark';
      setTheme(savedTheme);

      updateAuthState();
      navigateTo('home');
      lucide.createIcons();
    }

    /* -------------------------------------------------------------
       THEME MANAGEMENT
       ------------------------------------------------------------- */
    function setTheme(theme) {
      state.theme = theme;
      localStorage.setItem('lumina_theme', theme);
      const icon = document.getElementById('theme-icon');
      if (theme === 'light') {
        document.documentElement.classList.remove('dark');
        document.documentElement.classList.add('light');
        if (icon) icon.setAttribute('data-lucide', 'moon');
      } else {
        document.documentElement.classList.add('dark');
        document.documentElement.classList.remove('light');
        if (icon) icon.setAttribute('data-lucide', 'sun');
      }
      lucide.createIcons();
    }

    function toggleTheme() {
      setTheme(state.theme === 'dark' ? 'light' : 'dark');
    }

    /* -------------------------------------------------------------
       NAVIGATION ROUTER
       ------------------------------------------------------------- */
    function navigateTo(viewId) {
      state.currentView = viewId;

      // Update sidebar active highlights
      document.querySelectorAll('.nav-item').forEach(el => {
        if (el.getAttribute('data-view') === viewId) {
          el.classList.add('bg-lumina-800/80', 'text-white', 'border-l-2', 'border-lumina-purple');
          el.classList.remove('text-slate-400');
        } else {
          el.classList.remove('bg-lumina-800/80', 'text-white', 'border-l-2', 'border-lumina-purple');
          el.classList.add('text-slate-400');
        }
      });

